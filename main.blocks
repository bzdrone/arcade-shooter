<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="pxt-on-start" x="20" y="20">
    <statement name="HANDLER">
      <block type="set_current_tilemap">
        <value name="tilemap"><shadow type="tiles_tilemap_editor"><field name="tilemap">tilemap`trainingYard`</field></shadow></value>
        <next>
          <block type="shooter_set_weapon">
            <value name="damage"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
            <value name="interval"><shadow type="math_number"><field name="NUM">750</field></shadow></value>
            <value name="speed"><shadow type="math_number"><field name="NUM">80</field></shadow></value>
            <next>
              <block type="shooter_set_enemies">
                <value name="hitPoints"><shadow type="math_number"><field name="NUM">3</field></shadow></value>
                <value name="speed"><shadow type="math_number"><field name="NUM">10</field></shadow></value>
                <value name="interval"><shadow type="math_number"><field name="NUM">5000</field></shadow></value>
                <next><block type="shooter_start_game"></block></next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
