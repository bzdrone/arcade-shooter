<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="pxt-on-start" x="20" y="20">
    <statement name="HANDLER">
      <block type="set_current_tilemap">
        <value name="tilemap"><shadow type="tiles_tilemap_editor"><field name="tilemap">tilemap`trainingYard`</field></shadow></value>
        <next><block type="modifiers_max_health">
          <value name="value"><shadow type="math_number"><field name="NUM">100</field></shadow></value>
          <next><block type="modifiers_incoming_damage">
            <value name="value"><shadow type="math_number"><field name="NUM">100</field></shadow></value>
            <next><block type="modifiers_respawn_seconds">
              <value name="value"><shadow type="math_number"><field name="NUM">5</field></shadow></value>
              <next><block type="modifiers_friendly_fire">
                <value name="enabled"><shadow type="logic_boolean"><field name="BOOL">FALSE</field></shadow></value>
                <next><block type="shooter_set_mode"><field name="mode">shooter.Mode.Deathmatch</field><next><block type="shooter_start_game"></block></next></block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block>
    </statement>
  </block>
</xml>
